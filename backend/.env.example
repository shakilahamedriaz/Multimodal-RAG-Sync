# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL with pgvector extension. Create DB first:
#   psql -U postgres -c "CREATE DATABASE rag_db;"
#   psql -U postgres -d rag_db -c "CREATE EXTENSION IF NOT EXISTS vector;"
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/rag_db

# ─── Redis ────────────────────────────────────────────────────────────────────
# Used for job queue (Redis Streams) and response caching
REDIS_URL=redis://localhost:6379

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Required for embeddings (text-embedding-3-small) and LLM (gpt-4o)
OPENAI_API_KEY=sk-...

# ─── Anthropic (optional) ─────────────────────────────────────────────────────
# Enable Claude 3.5 Sonnet / Claude 3 Haiku as LLM providers
ANTHROPIC_API_KEY=sk-ant-...

# ─── Cohere (optional) ────────────────────────────────────────────────────────
# Enable Cohere Rerank API for cross-encoder reranking
COHERE_API_KEY=...

# ─── Object Storage ───────────────────────────────────────────────────────────
# "local" stores files in LOCAL_STORAGE_PATH (dev), "s3" uses AWS S3 (prod)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# ─── Security ─────────────────────────────────────────────────────────────────
# Random 32-char string used for API key signing — change before deploying
API_KEY_SECRET=change-me-to-a-random-32-character-string

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ─── Retrieval Defaults ───────────────────────────────────────────────────────
DEFAULT_TOP_K=20
DEFAULT_RERANK_N=5
DEFAULT_ALPHA=0.5
CONFIDENCE_THRESHOLD=0.35
